{
  "env": {
    "EXAMPLE_FLAG": "1"
  },
  "permissions": {
    "allow": [
      "Bash(npm test:*)"
    ]
  },
  "mcpServers": {
    "example": {
      "command": "node",
      "args": [
        "example-server.js"
      ]
    }
  },
  "model": "example-model",
  "hooks": {
    "SessionStart": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "Notification": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "SubagentStart": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "SubagentStop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "TeammateIdle": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "TaskCompleted": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write", "hooks": [{ "type": "command", "command": "node \"C:\\\\example\\\\sync-skills.js\" push --changed" }] },
      { "matcher": "Write|Edit", "hooks": [{ "type": "command", "command": "node \"C:/example/hooks/copy-check.mjs\"", "timeout": 15 }] },
      { "matcher": "", "hooks": [{ "type": "command", "command": "node \"C:\\\\Users\\\\example\\\\.pixel-agents\\\\hooks\\\\claude-hook.js\"", "timeout": 5 }] }
    ]
  }
}
